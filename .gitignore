# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

#Builds
noble-client/official-apps/NobleDoc/NobleDoc/Packages/NobleClientCrypto/.build/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Markdown files
*.md

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Environment
.env
.env.*


# Xcode project file (contains signing team IDs)
*.xcodeproj/project.pbxproj

# Xcode user-specific files
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Xcode build state
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/xcshareddata/xcschemes/xcschememanagement.plist

# Build products
build/
DerivedData/

# Code signing
*.mobileprovision
*.provisionprofile
ExportOptions.plist

# Archives
*.xcarchive

# Playgrounds
timeline.xctimeline
playground.xcworkspace


# CocoaPods (if ever used)
Pods/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# macOS
.AppleDouble
.LSOverride
._*

# Crashlytics
crashlytics-build.properties
crashlytics.properties
fabric.properties

# Markdown files (except README)
!README.md


# App-specific secrets
*.xcconfig.local
Secrets.swift

# Entitlements (contain team IDs and private signing info)
*.entitlements
