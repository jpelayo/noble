# Keep the build context small. Excludes everything not needed to compile
# noble-node, noble-tool, noble-faucet, or to copy noble-gui into the runtime.

# Cargo build artifacts (the build runs INSIDE the builder stage)
target
**/target

# Git + IDE
.git
.gitignore
.idea
.vscode
**/*.swp
**/.DS_Store

# Apple-side client apps (not needed for the server container)
noble-client/official-apps/NobleApp
noble-client/official-apps/NobleMac
noble-client/official-apps/NobleDoc
noble-client/official-apps/NobleWin

# WebUI assets are bundled in the client apps, not the server
noble-client/noble-client-libraries/WebUI

# Server-side test artifacts not needed at runtime
fuzz
testnet
Project

# Local secrets — never bake into image
docker/.env
**/.env
**/*.local

# Pre-built Apple xcframeworks (large, not used by the server)
**/*.xcframework
